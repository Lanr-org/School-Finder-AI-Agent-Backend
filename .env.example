NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_finder
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=replace-with-another-random-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Swagger UI at /docs. When unset: on in development, off in production.
DOCS_ENABLED=true
LOG_LEVEL=debug
# Reverse proxies in front of the API (Render: 1). 0 locally. Without it, per-IP rate limits
# treat every client as the proxy.
TRUST_PROXY=0

# Queues, rate counters and AI limits.
REDIS_URL=redis://127.0.0.1:6379

# Live updates to the staff app.
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=
CENTRIFUGO_HMAC_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Smetase <no-reply@example.com>

# Local development bootstrap only. prisma/seed.ts rejects production execution.
# In production create the first admin with `npm run bootstrap:admin` instead (see scripts/bootstrap-admin.ts).
# Production also requires: JWT_SECRET and COOKIE_SECRET of 32+ characters, and https:// for
# FRONTEND_URL and STUDENT_APP_URL.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_FULL_NAME=System Administrator

# Student sign-in (Google). Only the client ID is used; never add the client secret.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# At least 32 characters and different from JWT_SECRET, e.g. `openssl rand -hex 32`.
STUDENT_JWT_SECRET=replace-with-a-long-random-string
STUDENT_APP_URL=http://localhost:5174

# Telegram bot. The username (without @) builds the t.me links that connect a web account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_USERNAME=

# LLM: LLM_PROVIDER answers first; LLM_FALLBACK_PROVIDERS (comma list, or "none") are tried in order when it fails.
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDERS=openai,gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI usage limits: replies per UTC day (each student, and all students together), and
# Telegram messages per minute per chat. Also set a spend limit in the Anthropic console.
AI_DAILY_REPLIES_PER_STUDENT=40
AI_DAILY_REPLIES_GLOBAL=1500
TELEGRAM_MESSAGES_PER_MINUTE=20
# Mock interviews per student per UTC day (each is ~6 AI calls against the global cap).
INTERVIEW_SESSIONS_PER_STUDENT_PER_DAY=3

# Error monitoring. Leave SENTRY_DSN empty to turn Sentry off (local dev).
SENTRY_DSN=
# Defaults to NODE_ENV; set to e.g. "staging" or "production" to tell them apart.
SENTRY_ENVIRONMENT=
