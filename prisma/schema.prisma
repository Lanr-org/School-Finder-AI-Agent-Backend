// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//User staff db
enum UserRole {
  ADMIN
  ADVISOR
  OPERATIONS
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Users {
  id                  String     @id @default(uuid()) @db.Uuid
  public_id           String     @unique @db.VarChar(24)
  full_name           String     @db.VarChar(160)
  email               String     @unique
  phone               String?    @db.VarChar(40)
  password_hash       String?
  role                UserRole
  status              UserStatus @default(INVITED)
  last_login_at       DateTime?
  password_changed_at DateTime?
  token_version       Int        @default(0)
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  auth_sessions         Auth_Sessions[]
  password_reset_tokens Password_Reset_Tokens[]


  // NEW
  invitations_received Team_Invitations[] @relation("InvitationRecipient")
  invitations_sent     Team_Invitations[] @relation("InvitationSender")

  advisor_profile      AdvisorProfile?
  authored_notes       StudentNote[]
  authored_follow_ups  FollowUp[]
  authored_bulletins   IndustryBulletin[]
  authored_visa_rates  VisaSuccessRate[]
  generated_recommendation_runs RecommendationRun[]
  created_applications          StudentApplication[]
  application_status_changes    ApplicationStatusHistory[]
  student_status_changes        StudentStatusHistory[]

  @@map("users")
}

model Auth_Sessions {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid

  refresh_token_hash String @unique @db.VarChar(64)
  token_family       String @db.Uuid

  user_agent String?
  ip_address String? @db.Inet

  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime?
  last_used_at DateTime?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_family])
  @@map("auth_sessions")
}

model Password_Reset_Tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}


model Team_Invitations {
  id                  String    @id @default(uuid()) @db.Uuid

  user_id             String    @db.Uuid
  invited_by_user_id  String    @db.Uuid

  token_hash          String    @unique @db.Char(64)

  expires_at          DateTime  @db.Timestamptz(6)
  accepted_at         DateTime?
  canceled_at         DateTime?
  
  sent_at             DateTime  @default(now()) @db.Timestamptz(6)
  last_sent_at        DateTime  @default(now()) @db.Timestamptz(6)
  send_count          Int       @default(1)

  // The invited user
  user Users @relation( "InvitationRecipient", fields: [user_id], references: [id], onDelete: Cascade)

  // The admin/staff who sent the invitation
  invited_by Users @relation("InvitationSender", fields: [invited_by_user_id], references: [id])

  @@index([user_id])
  @@index([invited_by_user_id])
  @@map("team_invitations")
}

// ==========================================
// ENUMS FOR CONTACTS, STUDENTS & CONVERSATIONS
// ==========================================

enum ContactProvider {
  TELEGRAM
  WHATSAPP
  LIVE_CHAT
  FACEBOOK
  MANUAL
}

enum StudentStatus {
  NEW
  AWAITING_ASSIGNMENT
  ASSIGNED
  FOLLOW_UP
  APPLICATION_STARTED
  COMPLETED
  CLOSED
}

enum ConversationMode {
  AI_BOT
  HUMAN_ADVISOR
}

enum ConversationStatus {
  ACTIVE
  ESCALATED
  RESOLVED
}

enum MessageSenderType {
  STUDENT
  AGENT
  ADVISOR
  SYSTEM
}

// ==========================================
// MODELS FOR CONTACTS, STUDENTS & CONVERSATIONS
// ==========================================

model Contacts {
  id               String          @id @default(uuid()) @db.Uuid
  provider_type    ContactProvider @default(TELEGRAM)
  provider_user_id String          @db.VarChar(100)
  first_name       String          @db.VarChar(100)
  last_name        String?         @db.VarChar(100)
  username         String?         @db.VarChar(100)
  email            String?         @db.VarChar(255)
  phone            String?         @db.VarChar(40)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  student Student?

  @@unique([provider_type, provider_user_id])
  @@index([provider_user_id])
  @@map("contacts")
}

model Student {
  id                  String        @id @default(uuid()) @db.Uuid
  public_id           String        @unique @db.VarChar(24)
  contact_id          String        @unique @db.Uuid
  assigned_advisor_id String?       @db.Uuid
  status              StudentStatus @default(NEW)

  study_level         String?       @db.VarChar(50)
  target_destinations String[]
  target_intake_month IntakeMonth?
  target_intake_year  Int?
  budget_range        String?       @db.VarChar(100)
  academic_background String?       @db.Text
  english_test_score  String?       @db.VarChar(100)

  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)

  contact       Contacts        @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  conversations Conversations[]
  notes         StudentNote[]
  follow_ups    FollowUp[]
  recommendation_runs  RecommendationRun[]
  shortlisted_programs StudentShortlist[]
  applications         StudentApplication[]
  status_history       StudentStatusHistory[]

  @@index([assigned_advisor_id])
  @@index([status, created_at(sort: Desc)])
  @@map("students")
}

model Conversations {
  id               String             @id @default(uuid()) @db.Uuid
  public_id        String             @unique @db.VarChar(24)
  student_id       String             @db.Uuid
  mode             ConversationMode   @default(AI_BOT)
  status           ConversationStatus @default(ACTIVE)
  last_activity_at DateTime           @default(now()) @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)

  student  Student                @relation(fields: [student_id], references: [id], onDelete: Cascade)
  messages ConversationMessages[]

  @@index([student_id])
  @@index([mode, status])
  @@map("conversations")
}

model ConversationMessages {
  id              String            @id @default(uuid()) @db.Uuid
  conversation_id String            @db.Uuid
  sender_type     MessageSenderType
  content         String            @db.Text
  metadata        Json?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)

  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at(sort: Desc)])
  @@map("conversation_messages")
}

// ==========================================
// ENUMS FOR SCHOOLS & PROGRAMS
// ==========================================

enum SchoolType {
  UNIVERSITY
  COLLEGE
  INSTITUTE
  POLYTECHNIC
}

enum SchoolRecordStatus {
  ACTIVE
  INACTIVE
}

enum PartnerStatus {
  PARTNER
  PROSPECT
  NON_PARTNER
}

// ==========================================
// MODELS FOR SCHOOLS & PROGRAMS
// ==========================================

model Schools {
  id         String @id @default(uuid()) @db.Uuid
  public_id  String @unique @db.VarChar(24)

  // Profile
  name          String             @db.VarChar(200)
  school_type   SchoolType
  record_status SchoolRecordStatus @default(ACTIVE)
  description   String?            @db.Text

  // Contact & website
  website           String?  @db.VarChar(255)
  admissions_email  String?  @db.VarChar(255)
  phone_numbers     String[]

  // Location
  street_address String?  @db.VarChar(255)
  city           String   @db.VarChar(120)
  country        String   @db.VarChar(120)
  postal_code    String?  @db.VarChar(20)

  // Partnership & internal assessment
  partner_status                PartnerStatus @default(PROSPECT)
  visa_friendliness_score       Int?
  visa_friendliness_notes       String?       @db.Text
  admission_friendliness_score  Int?
  admission_friendliness_notes  String?       @db.Text
  ranking_reputation_notes      String?       @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  programs Programs[]

  @@index([country, city])
  @@index([partner_status])
  @@index([school_type])
  @@map("schools")
}

// ==========================================
// ENUMS FOR PROGRAMS
// ==========================================

enum StudyLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  FOUNDATION
}

enum IntakeMonth {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

model Programs {
  id        String @id @default(uuid()) @db.Uuid
  public_id String @unique @db.VarChar(24)

  // Profile
  name         String     @db.VarChar(200)
  study_level  StudyLevel
  qualification String    @db.VarChar(100) // e.g. "MRes", "MBA", "BEng (Hons)", "Postgraduate Diploma"
  category     String     @db.VarChar(120) // e.g. "Computer Science", "Business" — free text, not an enum
  duration     String     @db.VarChar(50)  // e.g. "2 years", "18 months"

  // School link
  school_id String  @db.Uuid
  school    Schools @relation(fields: [school_id], references: [id], onDelete: Cascade)

  // Tuition & funding
  tuition_amount           Decimal @db.Decimal(10, 2)
  tuition_currency         String  @db.VarChar(3) // ISO code, e.g. "USD", "GBP", "CAD"
  scholarship_availability String? @db.VarChar(100) // e.g. "Full", "10%", "25%", "None"

  // Intakes & deadlines
  intakes ProgramIntakes[]

  recommendations Recommendation[]
  shortlisted_by  StudentShortlist[]
  applications    StudentApplication[]

  // Entry requirements
  academic_requirements String? @db.Text
  english_requirements  String? @db.Text

  // Operations
  operation_notes String? @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([school_id])
  @@index([study_level])
  @@index([category])
  @@map("programs")
}

model ProgramIntakes {
  id                   String      @id @default(uuid()) @db.Uuid
  program_id           String      @db.Uuid
  month                IntakeMonth
  year                 Int
  application_deadline DateTime?

  program Programs @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([program_id, month, year])
  @@index([program_id])
  @@map("program_intakes")
}

// ==========================================
// ENUMS FOR ADVISOR PROFILES, NOTES & FOLLOW-UPS
// ==========================================

enum AdvisorAvailability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum FollowUpPriority {
  NORMAL
  HIGH
  URGENT
}

// OVERDUE is API-response-only (derived at read time from a PENDING row whose
// due_at has passed) — repositories only ever write PENDING, COMPLETED, or CANCELED.
enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELED
  OVERDUE
}

// ==========================================
// MODELS FOR ADVISOR PROFILES, NOTES & FOLLOW-UPS
// ==========================================

model AdvisorProfile {
  id           String              @id @default(uuid()) @db.Uuid
  user_id      String              @unique @db.Uuid
  availability AdvisorAvailability @default(AVAILABLE)
  max_capacity Int? // null = unlimited

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("advisor_profiles")
}

model StudentNote {
  id         String  @id @default(uuid()) @db.Uuid
  public_id  String  @unique @db.VarChar(24)
  student_id String  @db.Uuid
  advisor_id String  @db.Uuid
  body       String  @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  advisor Users   @relation(fields: [advisor_id], references: [id], onDelete: Restrict)

  @@index([student_id, created_at(sort: Desc)])
  @@map("student_notes")
}

model FollowUp {
  id          String           @id @default(uuid()) @db.Uuid
  public_id   String           @unique @db.VarChar(24)
  student_id  String           @db.Uuid
  advisor_id  String           @db.Uuid
  due_at      DateTime         @db.Timestamptz(6)
  priority    FollowUpPriority @default(NORMAL)
  status      FollowUpStatus   @default(PENDING)
  description String           @db.Text

  completed_at DateTime?
  canceled_at  DateTime?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  advisor Users   @relation(fields: [advisor_id], references: [id], onDelete: Restrict)

  @@index([student_id, status])
  @@index([advisor_id, status, due_at])
  @@map("follow_ups")
}

// ==========================================
// MODELS FOR SETTINGS (admin-configurable lookup lists)
// ==========================================

// Groups are fixed/seeded, not creatable via the API — only their values are
// admin-manageable (see AGENTS.md: "setting tables for admin-configurable
// values" vs. database enums for stable system states like StudentStatus).
model SettingGroup {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique @db.VarChar(60)
  label      String   @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  values SettingValue[]

  @@map("setting_groups")
}

model SettingValue {
  id         String   @id @default(uuid()) @db.Uuid
  group_id   String   @db.Uuid
  key        String   @db.VarChar(160) // slugified from label at creation, immutable after
  label      String   @db.VarChar(160)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  group SettingGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, key])
  @@index([group_id, is_active])
  @@map("setting_values")
}

// ==========================================
// MODELS FOR INDUSTRY INTEL (partner data -> AI grounding)
// ==========================================

// Ops/admin-entered content. Unlike SettingValue, these are not shared lookup
// values other records reference, so DELETE is a direct hard delete —
// is_active exists purely as a fast retract-without-losing-history toggle.
model IndustryBulletin {
  id             String    @id @default(uuid()) @db.Uuid
  public_id      String    @unique @db.VarChar(24)
  title          String    @db.VarChar(200)
  body           String    @db.Text
  source_partner String?   @db.VarChar(120)
  countries      String[] // empty array = applies globally
  published_at   DateTime  @db.Timestamptz(6)
  expires_at     DateTime? @db.Timestamptz(6) // null = doesn't expire
  is_active      Boolean   @default(true)
  created_by     String    @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  creator Users @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@index([is_active, expires_at])
  @@map("industry_bulletins")
}

model VisaSuccessRate {
  id             String   @id @default(uuid()) @db.Uuid
  public_id      String   @unique @db.VarChar(24)
  country        String   @db.VarChar(120)
  source_partner String?  @db.VarChar(120)
  period_label   String   @db.VarChar(60) // free text, e.g. "Q3 2026"
  success_rate   Decimal  @db.Decimal(5, 2) // 0-100, bounded at the Zod layer (see AGENTS.md precedent: Schools.visa_friendliness_score)
  sample_size    Int?
  published_at   DateTime @db.Timestamptz(6)
  is_active      Boolean  @default(true)
  created_by     String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  creator Users @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@index([country, is_active, published_at(sort: Desc)])
  @@map("visa_success_rates")
}

// ==========================================
// MODELS FOR THE RECOMMENDATION ENGINE
// ==========================================

// Versioned, never mutated in place — every PUT inserts a new row so past
// recommendation_runs stay reproducible against the weights active when they
// ran. Weight sum-to-100 is enforced at the Zod/service layer, not a DB CHECK
// constraint (no precedent for one anywhere else in this schema).
model RecommendationWeights {
  id             String   @id @default(uuid()) @db.Uuid
  version        Int      @unique
  program_weight Int
  budget_weight  Int
  intake_weight  Int
  visa_weight    Int
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("recommendation_weights")
}

model RecommendationRun {
  id               String   @id @default(uuid()) @db.Uuid
  public_id        String   @unique @db.VarChar(24)
  student_id       String   @db.Uuid
  weights_version  Int
  scoring_version  String   @db.VarChar(20)
  student_snapshot Json
  generated_by     String   @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  student     Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  generator   Users            @relation(fields: [generated_by], references: [id], onDelete: Restrict)
  recommendations Recommendation[]

  @@index([student_id, created_at(sort: Desc)])
  @@map("recommendation_runs")
}

model Recommendation {
  id                   String   @id @default(uuid()) @db.Uuid
  public_id            String   @unique @db.VarChar(24)
  run_id               String   @db.Uuid
  program_id           String   @db.Uuid
  program_fit          Decimal  @db.Decimal(5, 2) // 0-100, bounded at the Zod layer (see VisaSuccessRate.success_rate precedent)
  budget_fit           Decimal  @db.Decimal(5, 2)
  intake_fit           Decimal  @db.Decimal(5, 2)
  visa_fit             Decimal  @db.Decimal(5, 2)
  overall_score        Decimal  @db.Decimal(5, 2)
  reasons              String[]
  missing_requirements String[]
  program_snapshot     Json
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  run     RecommendationRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  program Programs          @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([run_id, program_id])
  @@index([run_id, overall_score(sort: Desc)])
  @@map("recommendations")
}

model StudentShortlist {
  student_id String   @db.Uuid
  program_id String   @db.Uuid
  added_at   DateTime @default(now()) @db.Timestamptz(6)

  student Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  program Programs @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@id([student_id, program_id])
  @@map("student_shortlists")
}

// ==========================================
// ENUMS FOR APPLICATIONS & STATUS HISTORY
// ==========================================

enum ApplicationStatus {
  DRAFT
  DOCUMENTS_PENDING
  SUBMITTED
  OFFER_RECEIVED
  VISA_PROCESSING
  COMPLETED
  REJECTED
  WITHDRAWN
}

// Why a student's status changed — lets the timeline say "moved to FOLLOW_UP
// because a follow-up was scheduled" instead of just showing the new value.
enum StudentStatusChangeSource {
  LEAD_CREATED
  MANUAL
  ADVISOR_ASSIGNED
  ADVISOR_UNASSIGNED
  FOLLOW_UP_CREATED
  APPLICATION_CREATED
}

// ==========================================
// MODELS FOR APPLICATIONS & STATUS HISTORY
// ==========================================

// program_id is Restrict (not Cascade like shortlists/recommendations):
// applications are operational history and must survive program changes.
// "One open application per student+program" is enforced in the service,
// not a partial unique index (no precedent for one in this schema).
model StudentApplication {
  id                 String            @id @default(uuid()) @db.Uuid
  public_id          String            @unique @db.VarChar(24)
  student_id         String            @db.Uuid
  program_id         String            @db.Uuid
  created_by         String            @db.Uuid
  status             ApplicationStatus @default(DRAFT)
  intake_month       IntakeMonth?
  intake_year        Int?
  external_reference String?           @db.VarChar(100) // school's own application number
  notes              String?           @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  student Student                    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  program Programs                   @relation(fields: [program_id], references: [id], onDelete: Restrict)
  creator Users                      @relation(fields: [created_by], references: [id], onDelete: Restrict)
  history ApplicationStatusHistory[]

  @@index([student_id, created_at(sort: Desc)])
  @@index([status, updated_at(sort: Desc)])
  @@index([program_id])
  @@map("student_applications")
}

// Append-only. from_status is null for the initial DRAFT row written on create.
model ApplicationStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  application_id String             @db.Uuid
  from_status    ApplicationStatus?
  to_status      ApplicationStatus
  changed_by     String?            @db.Uuid
  note           String?            @db.Text
  created_at     DateTime           @default(now()) @db.Timestamptz(6)

  application StudentApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)
  changer     Users?             @relation(fields: [changed_by], references: [id], onDelete: Restrict)

  @@index([application_id, created_at])
  @@map("application_status_history")
}

// Append-only. changed_by is null for system changes (Telegram lead creation).
// No backfill — rows start from this migration; earlier transitions were never recorded.
model StudentStatusHistory {
  id          String                    @id @default(uuid()) @db.Uuid
  student_id  String                    @db.Uuid
  from_status StudentStatus?
  to_status   StudentStatus
  source      StudentStatusChangeSource
  changed_by  String?                   @db.Uuid
  note        String?                   @db.Text // optional staff note; null for automatic changes
  created_at  DateTime                  @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  changer Users?  @relation(fields: [changed_by], references: [id], onDelete: Restrict)

  @@index([student_id, created_at(sort: Desc)])
  @@map("student_status_history")
}