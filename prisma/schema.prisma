// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//User staff db
enum UserRole {
  ADMIN
  ADVISOR
  OPERATIONS
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Users {
  id                  String     @id @default(uuid()) @db.Uuid
  public_id           String     @unique @db.VarChar(24)
  full_name           String     @db.VarChar(160)
  email               String     @unique
  phone               String?    @db.VarChar(40)
  password_hash       String?
  role                UserRole
  status              UserStatus @default(INVITED)
  last_login_at       DateTime?
  password_changed_at DateTime?
  token_version       Int        @default(0)
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  auth_sessions         Auth_Sessions[]
  password_reset_tokens Password_Reset_Tokens[]


  // NEW
  invitations_received Team_Invitations[] @relation("InvitationRecipient")
  invitations_sent     Team_Invitations[] @relation("InvitationSender")

  advisor_profile      AdvisorProfile?
  authored_notes       StudentNote[]
  authored_follow_ups  FollowUp[]

  @@map("users")
}

model Auth_Sessions {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid

  refresh_token_hash String @unique @db.VarChar(64)
  token_family       String @db.Uuid

  user_agent String?
  ip_address String? @db.Inet

  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime?
  last_used_at DateTime?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_family])
  @@map("auth_sessions")
}

model Password_Reset_Tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}


model Team_Invitations {
  id                  String    @id @default(uuid()) @db.Uuid

  user_id             String    @db.Uuid
  invited_by_user_id  String    @db.Uuid

  token_hash          String    @unique @db.Char(64)

  expires_at          DateTime  @db.Timestamptz(6)
  accepted_at         DateTime?
  canceled_at         DateTime?
  
  sent_at             DateTime  @default(now()) @db.Timestamptz(6)
  last_sent_at        DateTime  @default(now()) @db.Timestamptz(6)
  send_count          Int       @default(1)

  // The invited user
  user Users @relation( "InvitationRecipient", fields: [user_id], references: [id], onDelete: Cascade)

  // The admin/staff who sent the invitation
  invited_by Users @relation("InvitationSender", fields: [invited_by_user_id], references: [id])

  @@index([user_id])
  @@index([invited_by_user_id])
  @@map("team_invitations")
}

// ==========================================
// ENUMS FOR CONTACTS, STUDENTS & CONVERSATIONS
// ==========================================

enum ContactProvider {
  TELEGRAM
  WHATSAPP
  LIVE_CHAT
  FACEBOOK
  MANUAL
}

enum StudentStatus {
  NEW
  AWAITING_ASSIGNMENT
  ASSIGNED
  FOLLOW_UP
  APPLICATION_STARTED
  COMPLETED
  CLOSED
}

enum ConversationMode {
  AI_BOT
  HUMAN_ADVISOR
}

enum ConversationStatus {
  ACTIVE
  ESCALATED
  RESOLVED
}

enum MessageSenderType {
  STUDENT
  AGENT
  ADVISOR
  SYSTEM
}

// ==========================================
// MODELS FOR CONTACTS, STUDENTS & CONVERSATIONS
// ==========================================

model Contacts {
  id               String          @id @default(uuid()) @db.Uuid
  provider_type    ContactProvider @default(TELEGRAM)
  provider_user_id String          @db.VarChar(100)
  first_name       String          @db.VarChar(100)
  last_name        String?         @db.VarChar(100)
  username         String?         @db.VarChar(100)
  email            String?         @db.VarChar(255)
  phone            String?         @db.VarChar(40)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  student Student?

  @@unique([provider_type, provider_user_id])
  @@index([provider_user_id])
  @@map("contacts")
}

model Student {
  id                  String        @id @default(uuid()) @db.Uuid
  public_id           String        @unique @db.VarChar(24)
  contact_id          String        @unique @db.Uuid
  assigned_advisor_id String?       @db.Uuid
  status              StudentStatus @default(NEW)

  study_level         String?       @db.VarChar(50)
  target_destinations String[]
  target_intake_month IntakeMonth?
  target_intake_year  Int?
  budget_range        String?       @db.VarChar(100)
  academic_background String?       @db.Text
  english_test_score  String?       @db.VarChar(100)

  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)

  contact       Contacts        @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  conversations Conversations[]
  notes         StudentNote[]
  follow_ups    FollowUp[]

  @@index([assigned_advisor_id])
  @@index([status, created_at(sort: Desc)])
  @@map("students")
}

model Conversations {
  id               String             @id @default(uuid()) @db.Uuid
  public_id        String             @unique @db.VarChar(24)
  student_id       String             @db.Uuid
  mode             ConversationMode   @default(AI_BOT)
  status           ConversationStatus @default(ACTIVE)
  last_activity_at DateTime           @default(now()) @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)

  student  Student                @relation(fields: [student_id], references: [id], onDelete: Cascade)
  messages ConversationMessages[]

  @@index([student_id])
  @@index([mode, status])
  @@map("conversations")
}

model ConversationMessages {
  id              String            @id @default(uuid()) @db.Uuid
  conversation_id String            @db.Uuid
  sender_type     MessageSenderType
  content         String            @db.Text
  metadata        Json?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)

  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at(sort: Desc)])
  @@map("conversation_messages")
}

// ==========================================
// ENUMS FOR SCHOOLS & PROGRAMS
// ==========================================

enum SchoolType {
  UNIVERSITY
  COLLEGE
  INSTITUTE
  POLYTECHNIC
}

enum SchoolRecordStatus {
  ACTIVE
  INACTIVE
}

enum PartnerStatus {
  PARTNER
  PROSPECT
  NON_PARTNER
}

// ==========================================
// MODELS FOR SCHOOLS & PROGRAMS
// ==========================================

model Schools {
  id         String @id @default(uuid()) @db.Uuid
  public_id  String @unique @db.VarChar(24)

  // Profile
  name          String             @db.VarChar(200)
  school_type   SchoolType
  record_status SchoolRecordStatus @default(ACTIVE)
  description   String?            @db.Text

  // Contact & website
  website           String?  @db.VarChar(255)
  admissions_email  String?  @db.VarChar(255)
  phone_numbers     String[]

  // Location
  street_address String?  @db.VarChar(255)
  city           String   @db.VarChar(120)
  country        String   @db.VarChar(120)
  postal_code    String?  @db.VarChar(20)

  // Partnership & internal assessment
  partner_status                PartnerStatus @default(PROSPECT)
  visa_friendliness_score       Int?
  visa_friendliness_notes       String?       @db.Text
  admission_friendliness_score  Int?
  admission_friendliness_notes  String?       @db.Text
  ranking_reputation_notes      String?       @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  programs Programs[]

  @@index([country, city])
  @@index([partner_status])
  @@index([school_type])
  @@map("schools")
}

// ==========================================
// ENUMS FOR PROGRAMS
// ==========================================

enum StudyLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  FOUNDATION
}

enum IntakeMonth {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

model Programs {
  id        String @id @default(uuid()) @db.Uuid
  public_id String @unique @db.VarChar(24)

  // Profile
  name         String     @db.VarChar(200)
  study_level  StudyLevel
  qualification String    @db.VarChar(100) // e.g. "MRes", "MBA", "BEng (Hons)", "Postgraduate Diploma"
  category     String     @db.VarChar(120) // e.g. "Computer Science", "Business" — free text, not an enum
  duration     String     @db.VarChar(50)  // e.g. "2 years", "18 months"

  // School link
  school_id String  @db.Uuid
  school    Schools @relation(fields: [school_id], references: [id], onDelete: Cascade)

  // Tuition & funding
  tuition_amount           Decimal @db.Decimal(10, 2)
  tuition_currency         String  @db.VarChar(3) // ISO code, e.g. "USD", "GBP", "CAD"
  scholarship_availability String? @db.VarChar(100) // e.g. "Full", "10%", "25%", "None"

  // Intakes & deadlines
  intakes ProgramIntakes[]

  // Entry requirements
  academic_requirements String? @db.Text
  english_requirements  String? @db.Text

  // Operations
  operation_notes String? @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([school_id])
  @@index([study_level])
  @@index([category])
  @@map("programs")
}

model ProgramIntakes {
  id                   String      @id @default(uuid()) @db.Uuid
  program_id           String      @db.Uuid
  month                IntakeMonth
  year                 Int
  application_deadline DateTime?

  program Programs @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([program_id, month, year])
  @@index([program_id])
  @@map("program_intakes")
}

// ==========================================
// ENUMS FOR ADVISOR PROFILES, NOTES & FOLLOW-UPS
// ==========================================

enum AdvisorAvailability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum FollowUpPriority {
  NORMAL
  HIGH
  URGENT
}

// OVERDUE is API-response-only (derived at read time from a PENDING row whose
// due_at has passed) — repositories only ever write PENDING, COMPLETED, or CANCELED.
enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELED
  OVERDUE
}

// ==========================================
// MODELS FOR ADVISOR PROFILES, NOTES & FOLLOW-UPS
// ==========================================

model AdvisorProfile {
  id           String              @id @default(uuid()) @db.Uuid
  user_id      String              @unique @db.Uuid
  availability AdvisorAvailability @default(AVAILABLE)
  max_capacity Int? // null = unlimited

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("advisor_profiles")
}

model StudentNote {
  id         String  @id @default(uuid()) @db.Uuid
  public_id  String  @unique @db.VarChar(24)
  student_id String  @db.Uuid
  advisor_id String  @db.Uuid
  body       String  @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  advisor Users   @relation(fields: [advisor_id], references: [id], onDelete: Restrict)

  @@index([student_id, created_at(sort: Desc)])
  @@map("student_notes")
}

model FollowUp {
  id          String           @id @default(uuid()) @db.Uuid
  public_id   String           @unique @db.VarChar(24)
  student_id  String           @db.Uuid
  advisor_id  String           @db.Uuid
  due_at      DateTime         @db.Timestamptz(6)
  priority    FollowUpPriority @default(NORMAL)
  status      FollowUpStatus   @default(PENDING)
  description String           @db.Text

  completed_at DateTime?
  canceled_at  DateTime?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  advisor Users   @relation(fields: [advisor_id], references: [id], onDelete: Restrict)

  @@index([student_id, status])
  @@index([advisor_id, status, due_at])
  @@map("follow_ups")
}

// ==========================================
// MODELS FOR SETTINGS (admin-configurable lookup lists)
// ==========================================

// Groups are fixed/seeded, not creatable via the API — only their values are
// admin-manageable (see AGENTS.md: "setting tables for admin-configurable
// values" vs. database enums for stable system states like StudentStatus).
model SettingGroup {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique @db.VarChar(60)
  label      String   @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  values SettingValue[]

  @@map("setting_groups")
}

model SettingValue {
  id         String   @id @default(uuid()) @db.Uuid
  group_id   String   @db.Uuid
  key        String   @db.VarChar(160) // slugified from label at creation, immutable after
  label      String   @db.VarChar(160)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  group SettingGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, key])
  @@index([group_id, is_active])
  @@map("setting_values")
}